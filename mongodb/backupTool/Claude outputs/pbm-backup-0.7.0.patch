-          | [(.start | floor), (.end | floor)] ] | sort'
+    out=$(pbm_status_json) || { [[ -n $r ]] && { printf '%s\n' "$r"; return 0; }; return 1; }
+    printf '%s\n' "$out" | jq -c "(.backups.pitrChunks.pitrChunks // []) | ${_PITR_RANGES_JQ}"
 }
 
