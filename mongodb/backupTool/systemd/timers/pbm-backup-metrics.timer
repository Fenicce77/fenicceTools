# pbm-backup: Prometheus state metrics every 5 minutes
# Only useful with METRICS_DIR set; install.sh enables it with --metrics.
[Unit]
Description=pbm-backup: Prometheus state metrics every 5 minutes

[Timer]
OnCalendar=*:0/5
# Keep members in step: the election relies on all of them starting together.
AccuracySec=1s
Persistent=false
Unit=pbm-backup-metrics.service

[Install]
WantedBy=timers.target
