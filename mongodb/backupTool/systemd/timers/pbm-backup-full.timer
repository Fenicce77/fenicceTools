# pbm-backup: daily full backup at 00:00
# Persistent=true: a full missed while the host was down runs at boot;
# FULL_SAME_DAY_GUARD (one full per day) stops it if a full already ran today.
[Unit]
Description=pbm-backup: daily full backup at 00:00

[Timer]
OnCalendar=*-*-* 00:00:00
# Keep members in step: the election relies on all of them starting together.
AccuracySec=1s
Persistent=true
Unit=pbm-backup-full.service

[Install]
WantedBy=timers.target
